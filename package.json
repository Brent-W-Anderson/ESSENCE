{
    "private": true,
    "workspaces": [
        "frontend",
        "backend"
    ],
    "scripts": {
        "dev": "yarn workspace frontend start",
        "start": "yarn build && yarn workspace backend dev",
        "build": "yarn build:frontend && yarn build:backend",
        "build:frontend": "cd frontend/ && yarn build && cd ../",
        "build:backend": "cp \"backend/server.js\" \"dist/server.js\"",
        "clean": "rm -rf dist",
        "uninstall": "find . -name node_modules -type d -prune -exec rm -rf {} +; rm -rf dist yarn.lock",
        "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.cjs,.mjs && prettier --check \"**/*.json\"",
        "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx,.cjs,.mjs --fix && prettier --write \"**/*.json\""
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^8.46.2",
        "@typescript-eslint/parser": "^8.46.2",
        "concurrently": "^9.2.1",
        "eslint": "^9.5.0",
        "eslint-plugin-import": "^2.29.1",
        "eslint-plugin-solid": "^0.14.1",
        "prettier": "^3.3.2",
        "prettier-plugin-sort-json": "^4.1.1",
        "typescript": "^5.4.5"
    },
    "packageManager": "yarn@4.10.3"
}
